# Используем официальный образ Node.js
FROM node:18

# Создаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь код сервера
COPY . .

# Копируем файл с товарами
COPY ../data /data

# Указываем путь к файлу товаров через переменную окружения
ENV DATA_FILE=/data/products.json

# Открываем порт, который слушает сервер
EXPOSE 3000

# Команда запуска сервера
CMD ["node", "server.js"]